import numpy as np
from collections import Counter

def bootstrap(X, y):
    idx = np.random.choice(len(X), len(X), replace=True)
    return X[idx], y[idx]

def majority(y):
    return Counter(y).most_common(1)[0][0]

def build_tree(X, y, depth=0, max_depth=5):
    if depth >= max_depth or len(X) <= 1 or len(np.unique(y)) == 1:
        return {'val': majority(y)}

    best_gain, best_feat, best_thresh = -1, None, None

    for feat in range(X.shape[1]):
        for thresh in np.unique(X[:, feat]):
            left, right = y[X[:, feat] <= thresh], y[X[:, feat] > thresh]
            if len(left) == 0 or len(right) == 0:
                continue
            gain = (len(np.unique(left)) == 1) + (len(np.unique(right)) == 1)
            if gain > best_gain:
                best_gain, best_feat, best_thresh = gain, feat, thresh

    if best_feat is None:
        return {'val': majority(y)}

    mask = X[:, best_feat] <= best_thresh
    return {
        'feat': best_feat, 'thresh': best_thresh,
        'left': build_tree(X[mask], y[mask], depth + 1, max_depth),
        'right': build_tree(X[~mask], y[~mask], depth + 1, max_depth)
    }

def predict_tree(tree, x):
    if 'val' in tree:
        return tree['val']
    return predict_tree(tree['left'] if x[tree['feat']] <= tree['thresh'] else tree['right'], x)

def build_forest(X, y, n_trees=5, max_depth=5):
    return [build_tree(*bootstrap(X, y), max_depth=max_depth) for _ in range(n_trees)]

def predict_forest(forest, X):
    return np.array([majority([predict_tree(t, x) for t in forest]) for x in X])

# Test
if __name__ == "__main__":
    X = np.array([[1,2],[2,3],[3,3],[6,7],[7,8],[1,3]])
    y = np.array(['apple','apple','apple','mango','mango','apple'])

    forest = build_forest(X, y)
    preds = predict_forest(forest, X)
    print("Predictions:", preds)
    print("Actual:     ", y)
    print("Accuracy:   ", np.mean(preds == y))
