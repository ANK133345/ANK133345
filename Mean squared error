
features = [[0.5, 1.0], [-1.5, -2.0], [2.0, 1.5]], 
labels = [0, 1, 0]
weights = [0.7, -0.4]
bias = -0.1
o1 = features[0][0][0]* weights[0] + features[0][0][1] * weights[1] + bias
o2 = features[0][1][0]* weights[0] + features[0][1][1] * weights[1] + bias
o3 = features[0][2][0]* weights[0] + features[0][2][1] * weights[1] + bias
a1 = 1/(1+np.exp(-o1))
a2 = 1/(1+np.exp(-o2))
a3 = 1/(1+ np.exp(-o3))
activation = [a1,a2,a3]
squared_errors = []
for i in range(len(activation)):
    error = (labels[i]- activation[i])**2
    squared_errors.append(error)
mse = np.mean(squared_errors)
    
result = [round(a1,3),round(a2,3),round(a3,3),round(mse,3)]
print(result)
