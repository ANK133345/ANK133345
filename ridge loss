def ridge_loss(X,w,y_true,alpha):
    pred = np.dot(X,w)
    mse = np.mean((y_true - pred)**2)
    ridge = np.sum(alpha * (w **2))
    return mse + ridge
X = np.array([[1, 1], [2, 1], [3, 1], [4, 1]])
w = np.array([0.2, 2])
y_true = np.array([2, 3, 4, 5])
alpha = 0.1
res = ridge_loss(X,w,y_true,alpha)
print(res)
