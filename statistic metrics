How to calculate gini_impurity

class gini_impurity():
  def __init__(self,y):
    self.y = y

  def calculate(self):
    unique = np.unique(self.y,return_counts = True)
    prob_a = unique[1][0]/len(y)
    prob_b = unique[1][1]/len(y)
    gini_impurity = 1 -(prob_a**2 + prob_b**2)
    return gini_impurity
    
