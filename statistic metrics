import numpy as np

def gini_impurity(y):
  count = np.unique(y,return_counts = True)
  prob_a = count[1][0]/len(y)
  prob_b = count[1][1]/len(y)
  gini = 1 - (prob_a **2 + prob_b**2)
  return gini

