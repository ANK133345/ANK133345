How to create a R_Squared 
import numpy as np

def R_squared(y_true,y_pred):
  mean = np.mean(y_true)
  sse = np.sum((y_true - y_pred)**2)
  tse = np.sum((y_true - mean)**2)
  R_squared = 1-(sse/tse)
  return R_squared

y_true = np.array([1, 2, 3, 4, 5])
y_pred = np.array([1.1, 2.1, 2.9, 4.2, 4.8])

res = R_squared(y_true,y_pred)
print(res)


class R_squared:
  def __init__(self,y_true,y_pred):
    self.y_true = y_true
    self.y_pred = y_pred

  def calculate_R_squared(self):
    mean = np.mean(self.y_true)
    sse = np.sum((self.y_true - self.y_pred)**2)
    tse = np.sum((self.y_true - mean)**2)
    R_squared = 1-(sse/tse)
    return R_squared
  
